# The app reads real environment variables. To use this file: set -a; . ./.env; set +a
# Option A: Gemma 4 through Google AI Studio (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# tried in order; later ones are fallbacks if a model is missing on the API
GEMMA_MODEL=gemma-4-26b-a4b-it,gemma-4-31b-it,gemma-3-27b-it

# Option B: any OpenAI-compatible server, e.g. Ollama or mlx_lm.server on your own machine.
# Leave GEMINI_API_KEY empty to use this.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma4:e4b
# LLM_API_KEY=local
# LLM_THINKING=off

# Optional: plans per IP per 10 minutes (protects a free API quota)
# NOTYET_RATE_PER_10MIN=12
